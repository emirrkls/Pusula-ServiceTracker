<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Project Coordinates -->
    <groupId>com.pusulaiklimlendirme</groupId>
    <artifactId>servis-app</artifactId>
    <version>1.0.0</version>

    <!-- Properties Bloğu -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <javafx.version>24.0.1</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <jpackage.maven.plugin.version>1.6.0</jpackage.maven.plugin.version>
        <main.class>com.pusulaiklimlendirme.App</main.class>
        <app.name>PusulaServisTakip</app.name>
        <jlink.image.name>servis-app-runtime</jlink.image.name>
        <project.module.name>com.pusulaiklimlendirme</project.module.name>
        <slf4j.version>2.0.13</slf4j.version>
    </properties>

    <!-- Dependencies -->
    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
    </dependencies>

    <!-- Build Settings -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>24</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
                 <executions>
                     <execution>
                         <id>jlink</id>
                         <goals>
                             <goal>jlink</goal>
                         </goals>
                         <phase>package</phase>
                         <configuration>
                             <jlinkImageName>${jlink.image.name}</jlinkImageName>
                             <jlinkZipName>${jlink.image.name}-zip</jlinkZipName>
                             <noHeaderFiles>true</noHeaderFiles>
                             <noManPages>true</noManPages>
                             <stripDebug>true</stripDebug>
                             <compress>2</compress>
                             <addModules>
                                 <module>java.base</module>
                                 <module>java.sql</module>
                                 <module>javafx.controls</module>
                                 <module>javafx.fxml</module>
                                 <module>${project.module.name}</module> <!-- If module-info.java exists -->
                                 <module>org.slf4j</module>
                             </addModules>
                             <bindServices>true</bindServices>
                         </configuration>
                     </execution>
                 </executions>
            </plugin>
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>${jpackage.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>jpackage</id>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <name>${app.name}</name>
                            <appVersion>${project.version}</appVersion>
                            <vendor>Pusula Iklimlendirme</vendor>
                            <destination>target/dist</destination>
                            <runtimeImage>target/${jlink.image.name}</runtimeImage>
                            <type>EXE</type>
                            <launcher>${app.name}</launcher>
                            <mainClass>${main.class}</mainClass>
                            <module>${project.module.name}/${main.class}</module> <!-- If module-info.java exists -->
                            <!-- Windows Settings -->
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winDirChooser>true</winDirChooser>
                            <winUpgradeUuid>79d85b3f-1079-4244-a6f2-32a1b179951b</winUpgradeUuid> <!-- Your own UUID -->
                            <icon>src/main/resources/icons/app.ico</icon>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>