<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- AnchorPane tüm alanı kaplasın -->
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pusulaiklimlendirme.StokViewController">
   <children>
       <!-- Ana dikey düzenleyici -->
      <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
             <!-- 1. Parça İşlemleri Bölümü (Aynı kalıyor) -->
            <TitledPane animated="false" collapsible="false" text="Parça İşlemleri">
               <content>
                  <GridPane hgap="10.0" vgap="8.0">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="10.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Parça Adı:" />
                        <TextField fx:id="txtParcaAdi" promptText="Parça Adı (Örn: Kompresör)" GridPane.columnIndex="1" />
                        <Label text="Marka:" GridPane.columnIndex="2" />
                        <ComboBox fx:id="cmbParcaMarka" onAction="#handleParcaMarkaSecildi" prefWidth="200.0" promptText="Marka Seçin" GridPane.columnIndex="3" />
                        <Label text="Model:" GridPane.columnIndex="4" />
                        <ComboBox fx:id="cmbParcaModel" prefWidth="200.0" promptText="Önce Marka Seçin" GridPane.columnIndex="5" />
                        <Label text="Tip:" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cmbParcaTip" prefWidth="200.0" promptText="Tip Seçin (Örn: Buzdolabı)" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Alış Fiyatı (₺):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtParcaAlisFiyat" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label text="Satış Fiyatı (₺):" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                        <TextField fx:id="txtParcaSatisFiyat" promptText="0.00" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                        <Button fx:id="btnParcaEkle" mnemonicParsing="false" onAction="#handleParcaEkle" prefHeight="30.0" prefWidth="100.0" text="Parça Ekle" GridPane.columnSpan="6" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </GridPane>
               </content>
            </TitledPane>

             <!-- 2. Stok Hareketi Bölümü (Aynı kalıyor) -->
            <TitledPane animated="false" collapsible="false" text="Stok Hareketi">
               <content>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Parça:" />
                        <ComboBox fx:id="cmbStokParcaSec" prefWidth="300.0" promptText="Stok Hareketi Yapılacak Parçayı Seçin" />
                        <Label text="Adet:" />
                        <TextField fx:id="txtStokAdet" prefWidth="80.0" promptText="Adet" />
                        <Button fx:id="btnStokGiris" mnemonicParsing="false" onAction="#handleStokGiris" text="Stok Girişi" />
                        <Button fx:id="btnStokCikis" mnemonicParsing="false" onAction="#handleStokCikis" text="Stok Çıkışı" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
               </content>
            </TitledPane>

            <!-- 3. Stok Durumu Listesi Bölümü (GÜNCELLENDİ) -->
            <TitledPane animated="false" collapsible="false" text="Stok Durumu" VBox.vgrow="ALWAYS">
               <content>
                  <!-- İçeriği VBox içine alarak tablo ve butonları alt alta koyalım -->
                  <VBox spacing="10.0">
                     <children>
                        <!-- Stok Tablosu -->
                        <TableView fx:id="tblStokDurumu" prefHeight="400.0" VBox.vgrow="ALWAYS"> <!-- prefWidth kaldırıldı, VBox'a uyacak -->
                           <columns>
                              <TableColumn fx:id="colStokId" prefWidth="50.0" text="ID" />
                              <TableColumn fx:id="colStokParcaAdi" prefWidth="250.0" text="Parça" />
                              <TableColumn fx:id="colStokMarka" prefWidth="150.0" text="Marka" />
                              <TableColumn fx:id="colStokModel" prefWidth="150.0" text="Model" />
                              <TableColumn fx:id="colStokTip" prefWidth="150.0" text="Tip" />
                              <TableColumn fx:id="colStokAlis" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="Alış (₺)" />
                              <TableColumn fx:id="colStokSatis" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="Satış (₺)" />
                              <TableColumn fx:id="colStokAdet" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Stok" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>

                         <!-- YENİ EKLENEN BUTONLAR -->
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Button fx:id="btnParcaDuzenle" disable="true" mnemonicParsing="false" onAction="#handleParcaDuzenle" text="Seçili Parçayı Düzenle" />
                              <Button fx:id="btnParcaSil" disable="true" mnemonicParsing="false" onAction="#handleParcaSil" text="Seçili Parçayı Sil" />
                           </children>
                           <padding>
                              <Insets top="5.0" />
                           </padding>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </TitledPane>
         </children>
      </VBox>
   </children>
</AnchorPane>